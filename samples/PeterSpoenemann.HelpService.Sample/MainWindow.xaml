<Window x:Class="PeterSpoenemann.HelpService.Sample.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HelpService Sample"
        Width="760"
        Height="480"
        MinWidth="620"
        MinHeight="400"
        WindowStartupLocation="CenterScreen"
        PreviewKeyDown="Window_PreviewKeyDown">
    <DockPanel Margin="20">
        <Border DockPanel.Dock="Bottom"
                Margin="0,16,0,0"
                Padding="12"
                Background="#EEF4FA"
                BorderBrush="#B9CCE0"
                BorderThickness="1"
                CornerRadius="4">
            <DockPanel>
                <TextBlock VerticalAlignment="Center"
                           Text="Die Hilfe richtet sich nach der aktiven Registerkarte. F1 funktioniert ebenfalls." />
                <Button x:Name="HelpButton"
                        DockPanel.Dock="Right"
                        MinWidth="190"
                        Margin="16,0,0,0"
                        Padding="12,7"
                        Click="HelpButton_Click"
                        Content="Hilfe öffnen (F1)" />
            </DockPanel>
        </Border>

        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
            <TextBlock FontSize="26"
                       FontWeight="SemiBold"
                       Foreground="#174A7E"
                       Text="PeterSpoenemann.HelpService – Sample" />
            <TextBlock Margin="0,6,0,0"
                       Foreground="#4B5563"
                       Text="Ein kleiner Dialog mit kontextsensitiver Hilfe für zwei Registerkarten." />
        </StackPanel>

        <TabControl x:Name="SampleTabs" SelectionChanged="SampleTabs_SelectionChanged">
            <TabItem Header="Einstellungen" Tag="settings">
                <Grid Margin="18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.ColumnSpan="2"
                               Margin="0,0,0,18"
                               FontSize="19"
                               FontWeight="SemiBold"
                               Text="Allgemeine Einstellungen" />
                    <TextBlock Grid.Row="1" Margin="0,0,14,12" VerticalAlignment="Center" Text="Anzeigename:" />
                    <TextBox Grid.Row="1" Grid.Column="1" Margin="0,0,0,12" Padding="7" Text="Beispielbenutzer" />
                    <TextBlock Grid.Row="2" Margin="0,0,14,0" VerticalAlignment="Center" Text="Farbschema:" />
                    <ComboBox Grid.Row="2" Grid.Column="1" Padding="7" SelectedIndex="0">
                        <ComboBoxItem Content="Systemeinstellung" />
                        <ComboBoxItem Content="Hell" />
                        <ComboBoxItem Content="Dunkel" />
                    </ComboBox>
                </Grid>
            </TabItem>

            <TabItem Header="Auswertung" Tag="reports">
                <Grid Margin="18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Margin="0,0,0,18"
                               FontSize="19"
                               FontWeight="SemiBold"
                               Text="Auswertung erstellen" />
                    <StackPanel Grid.Row="1" Orientation="Horizontal">
                        <CheckBox Margin="0,0,22,0" VerticalAlignment="Center" Content="Details einschließen" IsChecked="True" />
                        <Button Padding="16,7" Content="Vorschau erzeugen" />
                    </StackPanel>
                    <Border Grid.Row="2"
                            Margin="0,18,0,0"
                            Padding="18"
                            Background="#FAFAFA"
                            BorderBrush="#D1D5DB"
                            BorderThickness="1">
                        <TextBlock Foreground="#6B7280"
                                   Text="Hier würde die erzeugte Auswertung angezeigt."
                                   TextAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
