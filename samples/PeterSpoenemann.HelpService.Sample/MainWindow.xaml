<Window x:Class="PeterSpoenemann.HelpService.Sample.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title=""
        Width="760"
        Height="480"
        MinWidth="620"
        MinHeight="400"
        WindowStartupLocation="CenterScreen"
        PreviewKeyDown="Window_PreviewKeyDown">
    <DockPanel Margin="20">
        <Border DockPanel.Dock="Bottom"
                Margin="0,16,0,0"
                Padding="12"
                Background="#EEF4FA"
                BorderBrush="#B9CCE0"
                BorderThickness="1"
                CornerRadius="4">
            <DockPanel>
                <TextBlock x:Name="HelpHintText" VerticalAlignment="Center" />
                <Button x:Name="HelpButton"
                        DockPanel.Dock="Right"
                        MinWidth="190"
                        Margin="16,0,0,0"
                        Padding="12,7"
                        Click="HelpButton_Click" />
            </DockPanel>
        </Border>

        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,16">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="LanguageLabel" Margin="0,0,8,0" VerticalAlignment="Center" />
                <ComboBox x:Name="LanguageSelector"
                          Width="120"
                          Padding="6,4"
                          SelectionChanged="LanguageSelector_SelectionChanged">
                    <ComboBoxItem x:Name="GermanLanguageItem" Tag="de" />
                    <ComboBoxItem x:Name="EnglishLanguageItem" Tag="en" />
                </ComboBox>
            </StackPanel>
            <StackPanel>
                <TextBlock x:Name="ProductTitleText"
                           FontSize="26"
                           FontWeight="SemiBold"
                           Foreground="#174A7E" />
                <TextBlock x:Name="SubtitleText"
                           Margin="0,6,0,0"
                           Foreground="#4B5563" />
            </StackPanel>
        </DockPanel>

        <TabControl x:Name="SampleTabs" SelectionChanged="SampleTabs_SelectionChanged">
            <TabItem x:Name="SettingsTab" Tag="settings">
                <Grid Margin="18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock x:Name="SettingsHeadingText" Grid.Row="0" Grid.ColumnSpan="2"
                               Margin="0,0,0,18"
                               FontSize="19"
                               FontWeight="SemiBold" />
                    <TextBlock x:Name="DisplayNameLabel" Grid.Row="1" Margin="0,0,14,12" VerticalAlignment="Center" />
                    <TextBox x:Name="DisplayNameTextBox" Grid.Row="1" Grid.Column="1" Margin="0,0,0,12" Padding="7" />
                    <TextBlock x:Name="ColorSchemeLabel" Grid.Row="2" Margin="0,0,14,0" VerticalAlignment="Center" />
                    <ComboBox Grid.Row="2" Grid.Column="1" Padding="7" SelectedIndex="0">
                        <ComboBoxItem x:Name="SystemThemeItem" />
                        <ComboBoxItem x:Name="LightThemeItem" />
                        <ComboBoxItem x:Name="DarkThemeItem" />
                    </ComboBox>
                </Grid>
            </TabItem>

            <TabItem x:Name="ReportsTab" Tag="reports">
                <Grid Margin="18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock x:Name="ReportsHeadingText" Grid.Row="0"
                               Margin="0,0,0,18"
                               FontSize="19"
                               FontWeight="SemiBold" />
                    <StackPanel Grid.Row="1" Orientation="Horizontal">
                        <CheckBox x:Name="IncludeDetailsCheckBox" Margin="0,0,22,0" VerticalAlignment="Center" IsChecked="True" />
                        <Button x:Name="GeneratePreviewButton" Padding="16,7" />
                    </StackPanel>
                    <Border Grid.Row="2"
                            Margin="0,18,0,0"
                            Padding="18"
                            Background="#FAFAFA"
                            BorderBrush="#D1D5DB"
                            BorderThickness="1">
                        <TextBlock x:Name="ReportPlaceholderText" Foreground="#6B7280"
                                   TextAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
